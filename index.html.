<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Amanda ✨</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: radial-gradient(circle at center, #1B2735 0%, #090A0F 100%);
            height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Arial', sans-serif;
            cursor: pointer;
            color: white;
            text-align: center;
        }

        #contenedor {
            z-index: 10;
            padding: 20px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 20px;
            backdrop-filter: blur(2px);
        }

        h1 {
            font-size: 4rem;
            text-shadow: 0 0 20px #fff, 0 0 30px #ff74d2;
            animation: flotar 3s ease-in-out infinite;
            margin: 0;
        }

        .frase {
            font-size: 1.3rem;
            font-style: italic;
            margin-top: 15px;
            opacity: 0;
            animation: aparecer 4s forwards;
            animation-delay: 1s;
            text-shadow: 0 0 10px rgba(255,255,255,0.8);
        }

        @keyframes flotar {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        @keyframes aparecer {
            to { opacity: 1; }
        }

        .star {
            position: absolute;
            border-radius: 50%;
            animation: parpadeo var(--d) infinite;
        }

        @keyframes parpadeo {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.3); }
        }
    </style>
</head>
<body onclick="tocarMusica()">

    <div id="contenedor">
        <h1 id="nombre">Amanda</h1>
        <p class="frase">"En medio de tantas estrellas, siempre serás la que más brilla en mi cielo."</p>
        <p style="font-size: 0.7rem; margin-top: 30px; opacity: 0.5;">(Toca la pantalla para escuchar a Morat 🎵)</p>
    </div>

    <audio id="musica" loop>
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3" type="audio/mpeg">
    </audio>

    <script>
        const colores = ['#ffffff', '#ffe9c4', '#d4fbff', '#ffb3fb', '#b3e5ff', '#ff74d2'];
        
        for (let i = 0; i < 250; i++) {
            let star = document.createElement('div');
            star.className = 'star';
            let size = Math.random() * 3 + 1 + 'px';
            star.style.width = size;
            star.style.height = size;
            star.style.top = Math.random() * 100 + 'vh';
            star.style.left = Math.random() * 100 + 'vw';
            star.style.background = colores[Math.floor(Math.random() * colores.length)];
            star.style.boxShadow = `0 0 ${Math.random() * 10}px ${star.style.background}`;
            star.style.setProperty('--d', Math.random() * 4 + 2 + 's');
            document.body.appendChild(star);
        }

        function tocarMusica() {
            var audio = document.getElementById('musica');
            audio.play();
        }
    </script>
</body>
</html>
