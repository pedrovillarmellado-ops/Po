<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Galaxia Protegida</title>
    <style>
        body { margin: 0; background: black; color: white; }
        /* ... tu código original aquí ... */
    </style>
</head>
<body>

    <div id="contenido-galaxia">
        </div>

    <audio id="miMusica" loop>
        <source src="URL_DE_TU_MUSICA.mp3" type="audio/mpeg">
        Tu navegador no soporta el audio.
    </audio>

    <script>
        // Función para que la música empiece al hacer clic
        document.body.addEventListener('click', function() {
            var audio = document.getElementById('miMusica');
            audio.play();
        }, { once: true }); // Solo se activa una vez
    </script>

</body>
</html>

